# LeadBot / AutoLead VPS
NODE_ENV=production
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadbot_db
DB_USER=leadbot
DB_PASSWORD=change-me

# WhatsApp transport: Fonnte only. Do not configure local WA session services.
FONNTE_TOKEN=
FONNTE_WEBHOOK_SECRET=

# KantorTeman bridge
KANTORTEMAN_API_URL=https://api.kantorteman.my.id
KANTORTEMAN_API_KEY=
KANTORTEMAN_BRIDGE_TOKEN=change-me
KANTORTEMAN_BRIDGE_DEMO=true

# Dashboard auth
# DB-backed dashboard auth. DASHBOARD_* seeds only the first user when DB is empty.
AUTH_ALLOWED_EMAIL_DOMAINS=temanumkmkita.com
DASHBOARD_EMAIL=admin@temanumkmkita.com
DASHBOARD_NAME=AutoLead Admin
DASHBOARD_USER=
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=change-me
DASHBOARD_AUTH_DISABLED=false
DASHBOARD_COOKIE_SECURE=true
AUTOLEAD_PUBLIC_URL=https://autolead.kantorteman.my.id

# Password reset email. Keep SMTP password only in production env.
SMTP_HOST=mail.temanumkmkita.com
SMTP_PORT=587
SMTP_USER=noreply@temanumkmkita.com
SMTP_PASSWORD=
SMTP_FROM=noreply@temanumkmkita.com

# AI: semua AutoLead AI call wajib lewat 9router OpenAI-compatible.
# Di VPS bisa gunakan http://127.0.0.1:20128/v1; dari luar VPS gunakan Cloudflare route ini.
AI_PROVIDER=9router
AI_ENDPOINT_STYLE=openai
AI_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_EXTERNAL_URL=http://9router.kantorteman.my.id/v1
AI_API_KEY=
AI_MODEL=combo-genflow
AI_MAX_TOKENS=450
AI_TIMEOUT_MS=30000
AI_TEMPERATURE=0.45

# Optional smoke script config
AUTOLEAD_BRIDGE_URL=https://leadbot.example.com
AUTOLEAD_SMOKE_SEND=false
AUTOLEAD_SMOKE_TARGET=
AUTOLEAD_SMOKE_MESSAGE=Smoke test AutoLead demo bridge from KantorTeman integration.
