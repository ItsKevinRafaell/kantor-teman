# LeadBot / AutoLead VPS
NODE_ENV=production
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadbot_db
DB_USER=leadbot
DB_PASSWORD=change-me

# WAHA local container on the VPS
WAHA_BASE_URL=http://127.0.0.1:3001
WAHA_API_KEY=change-me
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=change-me
WAHA_MEDIA_DOWNLOAD=false

# KantorTeman bridge
KANTORTEMAN_API_URL=https://api.kantorteman.my.id
KANTORTEMAN_API_KEY=
KANTORTEMAN_BRIDGE_TOKEN=change-me
KANTORTEMAN_BRIDGE_DEMO=true

# Dashboard auth
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# AI: semua AutoLead AI call wajib lewat 9router OpenAI-compatible.
# Di VPS bisa gunakan http://127.0.0.1:20128/v1; dari luar VPS gunakan Cloudflare route ini.
AI_PROVIDER=9router
AI_ENDPOINT_STYLE=openai
AI_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_EXTERNAL_URL=http://9router.kantorteman.my.id/v1
AI_API_KEY=
AI_MODEL=combo-genflow
AI_MAX_TOKENS=450
AI_TIMEOUT_MS=30000
AI_TEMPERATURE=0.45

# Optional smoke script config
AUTOLEAD_BRIDGE_URL=https://leadbot.example.com
AUTOLEAD_SMOKE_SEND=false
AUTOLEAD_SMOKE_TARGET=
AUTOLEAD_SMOKE_MESSAGE=Smoke test AutoLead demo bridge from KantorTeman integration.
