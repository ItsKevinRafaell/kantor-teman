# Leave NEXT_PUBLIC_API_URL empty in production. With an empty value,
# dashboard fetches go same-origin to Vercel (`/api/...`), which the
# Next.js rewrites() in next.config.js proxy to the FastAPI backend on
# api.kantorteman.my.id. The kt_token cookie (set with domain=.kantorteman.my.id
# and samesite=lax) is attached because the request is same-site.
#
# Set NEXT_PUBLIC_API_URL=https://api.kantorteman.my.id ONLY if you bypass
# the Vercel rewrite proxy and want direct cross-site requests — that
# configuration will trigger samesite=lax cookie suppression in browsers,
# producing repeated 401s in the SPA even when logged in.
NEXT_PUBLIC_API_URL=
