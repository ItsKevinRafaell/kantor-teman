# .env.production — Production environment variables for FastAPI
# Copy ini ke shared hosting: /home/qqwtlphb/backend/.env
# JANGAN commit .env dengan nilai asli!

JWT_SECRET="your-production-jwt-secret"
SECRET_ENCRYPTION_KEY="your-production-fernet-key"
FRONTEND_URL="https://kantor-teman-five.vercel.app"
CORS_ORIGIN="https://kantor-teman-five.vercel.app,https://kantorteman.my.id"
ENABLE_BACKGROUND_SCHEDULER="false"
FONNTE_WEBHOOK_SECRET=""

# MySQL di shared hosting
DATABASE_URL="mysql://qqwtlphb:password@localhost/qqwtlphb_kantorteman"

# WhatsApp provider
# Production shared hosting: pakai autolead agar KantorTeman memanggil VPS AutoLead.
WHATSAPP_PROVIDER="autolead"
WHATSAPP_BLAST_DELAY_SECONDS="5"
AUTOLEAD_BASE_URL="https://leadbot.example.com"
AUTOLEAD_API_KEY="change-me"
AUTOLEAD_DEMO="true"

# Direct WAHA hanya jika backend bisa menjangkau container WAHA langsung.
WAHA_BASE_URL="http://127.0.0.1:3001"
WAHA_SESSION="default"
WAHA_API_KEY=""
WAHA_WEBHOOK_SECRET=""

# API Keys (opsional)
GOOGLE_API_KEY=""
FONNTE_TOKEN=""
ADMIN_WA=""

# AI: semua fitur AI memakai 9router OpenAI-compatible.
# Shared hosting/cPanel gunakan URL publik ini; pastikan route Cloudflare aktif.
NINE_ROUTER_URL="http://9router.kantorteman.my.id/v1"
NINE_ROUTER_EXTERNAL_URL="http://9router.kantorteman.my.id/v1"
NINE_ROUTER_API_KEY=""
NINE_ROUTER_MODEL="combo-genflow"
AI_BASE_URL="http://9router.kantorteman.my.id/v1"
AI_MODEL="combo-genflow"
AI_API_KEY=""
