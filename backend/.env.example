GOOGLE_API_KEY=sample
SECRET_ENCRYPTION_KEY=your-fernet-key-here
DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname
JWT_SECRET=your-jwt-secret-here
FRONTEND_URL=https://kantorteman.my.id
CORS_ORIGIN=https://kantorteman.my.id
ENABLE_BACKGROUND_SCHEDULER=false
# Sub-flag (semua default OFF). Worker web Passenger JANGAN nyalain master.
# Process terpisah: python3 scripts/run_scheduler_worker.py --probe
ENABLE_BLAST_SCHEDULER=false
ENABLE_BILLING_SCHEDULER=false
ENABLE_FOLLOWUP_SCHEDULER=false
ENABLE_LIFECYCLE_SCHEDULER=false
FONNTE_WEBHOOK_SECRET=

# AI: semua fitur AI memakai 9router OpenAI-compatible.
# Di VPS pakai URL internal; di shared hosting/external pakai URL publik/tunnel.
NINE_ROUTER_URL=http://9router.kantorteman.my.id/v1
NINE_ROUTER_EXTERNAL_URL=http://9router.kantorteman.my.id/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=combo-genflow
AI_BASE_URL=http://9router.kantorteman.my.id/v1
AI_MODEL=combo-genflow

# WhatsApp provider:
# - fonnte: fallback lama
# - autolead: shared hosting -> AutoLead Bridge VPS -> WAHA lokal VPS
# - waha: hanya jika backend ini bisa menjangkau WAHA langsung
WHATSAPP_PROVIDER=autolead
WHATSAPP_BLAST_DELAY_SECONDS=5

# Fonnte fallback
FONNTE_TOKEN=

# AutoLead Bridge demo/production
AUTOLEAD_BASE_URL=https://leadbot.example.com
AUTOLEAD_API_KEY=change-me
AUTOLEAD_DEMO=true

# Direct WAHA, hanya untuk environment yang bisa menjangkau container WAHA
WAHA_BASE_URL=http://127.0.0.1:3001
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
